/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        overwrite: params.publish_dir_overwrite,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: MERGE_BARCODES {
        publishDir = [
            path: { "${params.outdir}/fastq_pass_merged" },
            mode: params.publish_dir_mode,
            overwrite: params.publish_dir_overwrite,
            pattern: 'fastq_pass_merged',
            enabled: params.save_merged_reads
        ]
    }

    withName: MERGE_BARCODES_SAMPLESHEET {
        publishDir = [
            path: { "${params.outdir}/fastq_pass_merged" },
            mode: params.publish_dir_mode,
            overwrite: params.publish_dir_overwrite,
            pattern: 'fastq_pass_merged',
            enabled: params.save_merged_reads
        ]
    }

    withName: BARBELL_KIT {
        ext.args = [
            "--kit ${params.barbell_kit}",
            "--min-score-diff ${params.barbell_min_score_diff}",
        ].join(' ')
        publishDir = [
            [
                path: { "${params.outdir}/barbell" },
                mode: params.publish_dir_mode,
                overwrite: params.publish_dir_overwrite,
                pattern: '*.{log,txt}'
            ],
            [
                path: { "${params.outdir}/barbell" },
                mode: params.publish_dir_mode,
                overwrite: params.publish_dir_overwrite,
                pattern: 'barbell_read_counts.tsv'
            ],
            [
                path: { "${params.outdir}/barbell" },
                mode: params.publish_dir_mode,
                overwrite: params.publish_dir_overwrite,
                pattern: '*.tsv.gz',
                enabled: params.save_barbell_annotation
            ],
            [
                path: { "${params.outdir}/fastq_pass_merged" },
                mode: params.publish_dir_mode,
                overwrite: params.publish_dir_overwrite,
                pattern: 'fastq_pass_demuxed',
                enabled: params.save_merged_reads
            ]
        ]
    }

    withName: PREPARE_EMU_DB {
        publishDir = [
            path: { "${params.outdir}/pipeline_info" },
            mode: params.publish_dir_mode,
            overwrite: params.publish_dir_overwrite,
            pattern: 'emu_db_summary.tsv'
        ]
    }

    withName: DEACON_FILTER {
        ext.args = "--rel-threshold ${params.deacon_rel_threshold}"
        ext.prefix = { "${meta.id}_dehosted" }
        publishDir = [
            [
                path: { "${params.outdir}/deacon" },
                mode: params.publish_dir_mode,
                overwrite: params.publish_dir_overwrite,
                pattern: '*.json'
            ],
            [
                path: { "${params.outdir}/deacon" },
                mode: params.publish_dir_mode,
                overwrite: params.publish_dir_overwrite,
                pattern: '*.fq.gz',
                enabled: params.save_dehosted_reads
            ]
        ]
    }

    withName: SAVONT_ASV {
        ext.when = { params.seqtype in ["map-ont", "lr:hq"] }
        publishDir = [
            path: { "${params.outdir}/results/savont" },
            mode: params.publish_dir_mode,
            overwrite: params.publish_dir_overwrite,
            pattern: '*.{fasta,tsv,log}'
        ]
    }

    withName: SAVONT_INDEX {
        publishDir = [
            enabled: false
        ]
    }

    withName: SAVONT_CLASSIFY {
        publishDir = [
            path: { "${params.outdir}/results/savont" },
            mode: params.publish_dir_mode,
            overwrite: params.publish_dir_overwrite,
            pattern: '*.{tsv,log}'
        ]
    }

    withName: COMPARE_CLASSIFIERS {
        publishDir = [
            enabled: false
        ]
    }

    withName: EMU_CHECK_CALLS {
        publishDir = [
            enabled: false
        ]
        ext.args = [
            "--max-error ${params.check_max_error}",
            "--min-reads ${params.check_min_reads}",
            "--min-probability ${params.check_min_probability}",
            "--min-share ${params.check_min_share}",
        ].join(' ')
    }

    withName: GENERATE_INPUT {
        publishDir = [
            path: { "${params.outdir}" },
            mode: params.publish_dir_mode,
            overwrite: params.publish_dir_overwrite,
            pattern: 'samplesheet_merged.csv'
        ]
    }

    withName: GENERATE_MASTER_HTML {
        ext.args = {
            def long_reads = params.seqtype in ["map-ont", "lr:hq"]
            def filtered = long_reads && params.quality_filtering
            def sections = [
                barbell: params.merge_fastq_pass && !params.skip_barbell,
                deacon: !params.skip_host_removal,
                filtlong: filtered,
                nanoplot: long_reads,
                nanoplot_processed: long_reads && (params.quality_filtering || params.downsample_n_reads),
                krona: params.run_krona,
                // emu names its reports after the reads, so only this case has a known name
                emu_tables: filtered && !params.downsample_n_reads,
                heatmap: params.make_heatmap,
                savont: long_reads && params.run_savont,
                read_buckets: long_reads && !params.skip_read_buckets,
                phyloseq: params.phyloseq,
            ].findAll { it.value }.keySet().join(',')
            [
                sections ? "--sections ${sections}" : '',
                params.merge_fastq_pass ? "--run-path ${params.merge_fastq_pass}" : '',
            ].join(' ').trim()
        }
        publishDir = [
            path: { "${params.outdir}" },
            mode: params.publish_dir_mode,
            overwrite: params.publish_dir_overwrite,
            pattern: '*_master.html'
        ]
    }

    withName: READ_BUCKETS {
        ext.args = {
            [
                // read structure needs the 16S_mix primers of SQK-MAB114-24 and barbell's trimming
                params.merge_fastq_pass && !params.skip_barbell && params.barbell_kit == 'SQK-MAB114-24-16S' ? '--structure' : '',
                params.quality_filtering ? "--min-length ${params.longread_qc_qualityfilter_minlength}" : '',
                params.quality_filtering ? "--max-length ${params.longread_qc_qualityfilter_maxlength}" : '',
                params.quality_filtering ? "--min-accuracy ${params.longread_qc_qualityfilter_min_mean_q}" : '',
            ].findAll { it }.join(' ')
        }
        publishDir = [
            path: { "${params.outdir}/read_buckets/samples" },
            mode: params.publish_dir_mode,
            overwrite: params.publish_dir_overwrite,
            pattern: '*.{tsv.gz,json}'
        ]
    }

    withName: READ_BUCKETS_REPORT {
        ext.args = {
            [
                params.merge_fastq_pass && !params.skip_barbell ? "--kit ${params.barbell_kit}" : '',
                params.merge_fastq_pass ? "--run-path ${params.merge_fastq_pass}" : '',
            ].findAll { it }.join(' ')
        }
        publishDir = [
            path: { "${params.outdir}/read_buckets" },
            mode: params.publish_dir_mode,
            overwrite: params.publish_dir_overwrite,
            pattern: 'read_buckets*.{html,tsv}'
        ]
    }

    withName: GENERATE_YAML {
        publishDir = [
            path: { "${params.outdir}/yaml" },
            mode: params.publish_dir_mode,
            overwrite: params.publish_dir_overwrite,
        ]
    }

    withName: NANOPLOT_UNPROCESSED_READS {
        publishDir = [
            path: { "${params.outdir}/nanoplot_unprocessed" },
            mode: params.publish_dir_mode,
            overwrite: params.publish_dir_overwrite,
            pattern: '*.{html,log,png,txt,yml}'
        ]
        ext.prefix = { "${meta.id}_nanoplot_unprocessed_" } // A closure can be used to access variables defined in the script
        ext.when = { params.seqtype in ["map-ont", "lr:hq"] }

    }

    withName: NANOPLOT_PROCESSED_READS {
        publishDir = [
            path: { "${params.outdir}/nanoplot_processed" },
            mode: params.publish_dir_mode,
            overwrite: params.publish_dir_overwrite,
            pattern: '*.{html,log,png,txt,yml}'
        ]
        ext.prefix = { "${meta.id}_nanoplot_processed_" }                   // A closure can be used to access variables defined in the script
        ext.when = { params.seqtype in ["map-ont", "lr:hq"] }

    }

    withName: PORECHOP_ABI {
        publishDir = [
            path: { "${params.outdir}/porechop_abi" },
            mode: params.publish_dir_mode,
            overwrite: params.publish_dir_overwrite,
            pattern: '*.{log,yml}'
        ]
    }

    withName: FASTQC {
        ext.args = '--quiet'
    }

    withName: CUTADAPT {
        ext.args = { [
        "--minimum-length 1",
        "-O ${params.cutadapt_min_overlap}",
        "-e ${params.cutadapt_max_error_rate}",
        // Use primers from the samplesheet if available, otherwise fall back to params
        meta.fw_primer ? "-g ${meta.fw_primer}" : (params.FW_primer ? "-g ${params.FW_primer}" : ''),
        meta.rv_primer ? "-G ${meta.rv_primer}" : (params.RV_primer ? "-G ${params.RV_primer}" : ''),
        params.retain_untrimmed ? '' : "--discard-untrimmed"
        ].findAll { it }.join(' ').trim() } // Remove empty strings and join arguments

        ext.prefix = { "${meta.id}.trimmed" }

        publishDir = [
            [   path: { "${params.outdir}/cutadapt" },
                mode: params.publish_dir_mode,
                overwrite: params.publish_dir_overwrite,
                pattern: "*.log"
            ],
            [   path: { "${params.outdir}/cutadapt/trimmed_reads" },
                mode: params.publish_dir_mode,
                overwrite: params.publish_dir_overwrite,
                pattern: "*.trim.fastq.gz",
                enabled: params.save_intermediates
            ]
        ]
    }

    withName: CUSTOM_DUMPSOFTWAREVERSIONS {
        publishDir = [
            path: { "${params.outdir}/pipeline_info" },
            mode: params.publish_dir_mode,
            overwrite: params.publish_dir_overwrite,
            pattern: '*_versions.yml'
        ]
    }

    withName: EMU_ABUNDANCE {
        publishDir = [
            [
                path: { "${params.outdir}/results" },
                mode: params.publish_dir_mode,
                overwrite: params.publish_dir_overwrite,
                pattern: '*{.tsv,txt}'
            ],
            [
                path: { "${params.outdir}/results" },
                mode: params.publish_dir_mode,
                overwrite: params.publish_dir_overwrite,
                pattern: '*{.sam}',
                enabled: params.keep_files,
            ],
            [
                path: { "${params.outdir}/results/emu_logs/" },
                mode: params.publish_dir_mode,
                overwrite: params.publish_dir_overwrite,
                pattern: '*{emu_log.log}'
            ],
            [
                path: { "${params.outdir}/results" },
                mode: params.publish_dir_mode,
                overwrite: params.publish_dir_overwrite,
                pattern: '*.{fastq_unclassified_mapped.fasta,fastq_unmapped.fasta}',
                enabled: params.output_unclassified
            ],

        ]

        ext.args = [
            "--type ${params.seqtype}",
            "--output-dir ./",
            "--min-abundance ${params.min_abundance}",
            "--N ${params.minimap_max_alignments}",
            "--K ${params.minibatch_size}",
            "--keep-counts",
            // the call check reads both the assignments and the alignments
            params.keep_read_assignments || params.check_emu_calls ? "--keep-read-assignments" : "",
            params.keep_files || params.check_emu_calls ? "--keep-files" : "",
            params.output_unclassified ? "--output-unclassified" : "",
        ].join(' ')                                                           // Join converts the list here to a string.
        ext.prefix = { "${meta.id}" }                                         // A closure can be used to access variables defined in the script
        ext.bam = params.check_emu_calls
        ext.keep_sam = params.keep_files
    }

    withName: KRONA_KTIMPORTTEXT {
        ext.prefix = { "${meta.id}_krona" }
        publishDir = [
            path: { "${params.outdir}/krona" },
            mode: params.publish_dir_mode,
            overwrite: params.publish_dir_overwrite,
            pattern: '*.{html}'
        ]
    }

    withName: EMU_REPORT_TO_KRONA {
        publishDir = [
            enabled: false
        ]
    }

    withName: PHYLOSEQ_OBJECT {
        ext.prefix = { "${meta.id}_phyloseq" }
        publishDir = [
            path: { "${params.outdir}/phyloseq/" },
            mode: params.publish_dir_mode,
            pattern: '*.{RData}'
            //pattern: '*.{RDS}'
        ]
    }

    withName: FILTLONG {
        ext.args = [
            "--min_length ${params.longread_qc_qualityfilter_minlength}",
            "--max_length ${params.longread_qc_qualityfilter_maxlength}",
            "--min_mean_q ${params.longread_qc_qualityfilter_min_mean_q}"
        ]
        .join(' ').trim()
        //ext.prefix = { "${meta.id}_${meta.run_accession}_filtered" }
        ext.prefix = { "${meta.id}_filtered" }

        publishDir = [
            [
                path: { "${params.outdir}/filtlong" },
                mode: params.publish_dir_mode,
                overwrite: params.publish_dir_overwrite,
                pattern: '*.fastq.gz',
                enabled: params.save_preprocessed_reads
            ],
            [
                path: { "${params.outdir}/filtlong" },
                mode: params.publish_dir_mode,
                overwrite: params.publish_dir_overwrite,
                pattern: '*.log'
            ]
        ]
    }

    withName: EMU_COMBINE_OUTPUTS {
        publishDir = [
            [
                path: { "${params.outdir}/results/emu-combined" },
                mode: params.publish_dir_mode,
                pattern: '{collected_reports_dir/emu-combined-*.tsv,collected_reports_counts_dir/emu-combined-*.tsv,txt,*.log}'
            ],

        ]

        ext.args = [
            "${params.combine_levels}",
            params.combine_split_tables ? "--split-tables" : "",
        ].join(' ')                                                           // Join converts the list here to a string.
        ext.prefix = { "${meta.id}" }                                         // A closure can be used to access variables defined in the script

    }
    withName: TRANSLATE_TAXIDS {
        publishDir = [
            [
                path: { "${params.outdir}/results/translate_taxids/" },
                mode: params.publish_dir_mode,
                pattern: '{*read-assignment-distributions_translated.tsv}'
            ],
            [
                path: { "${params.outdir}/results/translate_taxids/" },
                mode: params.publish_dir_mode,
                pattern: '{*log.log}'
            ],
        ]
        ext.prefix = { "${meta.id}" }                                         // A closure can be used to access variables defined in the script

    }

    withName: ASSIGNMENT_HEATMAP {
        publishDir = [
            [
                path: { "${params.outdir}/results/assignment_heatmap/" },
                mode: params.publish_dir_mode,
                pattern: '{*assignment_heatmap.png}'
            ],
            [
                path: { "${params.outdir}/results/assignment_heatmap/assignment_heatmap_logs" },
                mode: params.publish_dir_mode,
                pattern: '{*log.log}'
            ],
        ]
        ext.prefix = { "${meta.id}" }                                         // A closure can be used to access variables defined in the script

    }
    withName: CTRL_COMPARISON {
        publishDir = [
            [
                path: { "${params.outdir}/results/ctrl_comparison/" },
                mode: params.publish_dir_mode,
                pattern: '{plots_vs_selected_ctrl/*.png}'
            ],
            [
                path: { "${params.outdir}/results/ctrl_comparison/" },
                mode: params.publish_dir_mode,
                pattern: '{*log.log}'
            ],
        ]
        ext.args = [
            params.ctrl_1 ? "--ctrl_1 ${params.ctrl_1}" : "",
            params.ctrl_2 ? "--ctrl_2 ${params.ctrl_2}": "",
        ].join(' ')
        ext.prefix = { "${meta.id}" }                                         // A closure can be used to access variables defined in the script

    }
    withName: SEQTK_SAMPLE {
        publishDir = [
            path: { "${params.outdir}/seqtk" },
            mode: params.publish_dir_mode,
            pattern: '{*downsampled.fastq.gz}',
            enabled: params.save_downsampled_reads
        ]
        ext.prefix = { "${meta.id}_downsampled" }
    }
}
